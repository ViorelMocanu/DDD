{
	"name": "dedede-ro",
	"version": "1.0.0",
	"private": true,
	"description": "Sursa site-ului DeDeDe.ro",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "astro check",
		"verify": "pnpm lint && pnpm typecheck && pnpm format",
		"test": "pnpm build && pnpm test:unit",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"verify:live": "node scripts/verify-live.mjs",
		"prepare": "husky"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@10.33.2",
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp"
		],
		"peerDependencyRules": {
			"allowedVersions": {
				"eslint-plugin-jsx-a11y>eslint": "^10"
			}
		},
		"overrides": {
			"minimatch@>=7.0.0 <11.0.1": "^11.0.1"
		}
	},
	"dependencies": {
		"astro": "^7.4.10"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"husky": "^9.1.7",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	},
	"author": "Viorel Mocanu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ViorelMocanu/DDD.git"
	}
}
