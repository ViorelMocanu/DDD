# .prettierignore — keep the `pnpm format` gate scoped to project source.
# Mirrors the eslint globalIgnores / tsconfig exclude / knip ignore boundaries
# so the format gate is green and never touches committed inputs or generated files.

# Dependencies & build output
node_modules/
dist/
.astro/
.wrangler/
coverage/
playwright-report/
test-results/
.lighthouseci/

# Parity harness + baseline fixtures — committed INPUTS, never reformatted
parity/

# Gitignored FTP snapshot of the legacy site (non-deliverable)
livesite/

# AI scratch / reference material (non-deliverable)
tmp/

# Generated / machine-owned files
pnpm-lock.yaml
skills-lock.json

# Legacy & meta docs not owned by this rebuild's style
suggested_AGENTS.md
suggested_CODING_PRINCIPLES.md

